#pragma kernel CSMain

StructuredBuffer<uint> BinaryDataBuffer;
RWTexture2D<float4> Result;

static const int TextureWidth = 512;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID) {
    // Calculate linear index from 2D coordinates
    uint linearIndex = id.x + id.y * TextureWidth;

    // Calculate index for uint buffer
    uint bufferIndex = linearIndex / 32u; // Use uint for division
    uint bitOffset = linearIndex % 32u;   // Use uint for modulo

    // Access the uint from the buffer
    uint binaryValue = BinaryDataBuffer[bufferIndex];

    // Extract the specific bit from the uint
    bool bitResult = (binaryValue & (1u << bitOffset)) != 0;

    // For example, set the color of the Result texture based on the extracted bit
    Result[id.xy] = float4(bitResult ? 1.0 : 0.0, bitResult ? 1.0 : 0.0, bitResult ? 1.0 : 0.0, 1.0);

}
