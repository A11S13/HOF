#pragma kernel CSMain

// Declare a StructuredBuffer<uint> to hold the binary array data
StructuredBuffer<uint> BinaryDataBuffer;

// Define a RWTexture2D to hold the boolean array result
RWTexture2D<float4> Result;

// Set the actual width of your texture
static const int TextureWidth = 512;

[numthreads(1, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID) {
    // Sample binary data
    uint binaryValue = BinaryDataBuffer[id.x + id.y * TextureWidth];

    // Convert uint to boolean in HLSL directly
    bool value = binaryValue != 0;

    // Output boolean array result directly to Render Texture
    Result[id.xy] = float4(value, value, value, 1.0);
}
